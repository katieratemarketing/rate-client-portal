# Supabase (create a project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser. Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin passcode gate (checked server-side; not shipped to the client bundle)
ADMIN_PASSCODE=change-me
# Random secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-too
